# Copy to .env (gitignored) and fill in. Real environment variables override this file.

# Required: admin login password, 12+ characters. Never commit a real value.
ICEGHOST_ADMIN_PASSWORD=

# Directory for the SQLite database
ICEGHOST_DATA=./data

# 1 = development mode (cookies allowed over http). Leave 0 in production.
ICEGHOST_DEV=0

# Optional (docker compose): host port to publish, default 8080
# ICEGHOST_PORT=8080

# Listen address, only for running from source (dotnet run); Docker/compose set it themselves
# ASPNETCORE_URLS=http://localhost:5000
